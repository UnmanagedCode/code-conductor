{
  "_comment": "Headless root, gated, queueing: the first prompt opens a turn that never ends on its own. A later prompt is written into that open turn with no tool round-trip before its end, so the CLI queues it: the open turn ends, then a new turn opens (system/init, status:requesting) and answers it with one message.",
  "events": [
    {
      "type": "system",
      "subtype": "init",
      "session_id": "$SID",
      "cwd": "$CWD",
      "model": "claude-sonnet-4-6",
      "permissionMode": "$MODE"
    }
  ],
  "turns": [
    {
      "on": {
        "type": "prompt",
        "text": "[Headless run]"
      },
      "emit": [
        {
          "type": "stream_event",
          "event": {
            "type": "message_start",
            "message": {
              "id": "msg_h1",
              "role": "assistant"
            }
          }
        },
        {
          "type": "stream_event",
          "event": {
            "type": "content_block_start",
            "index": 0,
            "content_block": {
              "type": "text",
              "text": ""
            }
          }
        },
        {
          "type": "stream_event",
          "event": {
            "type": "content_block_delta",
            "index": 0,
            "delta": {
              "type": "text_delta",
              "text": "Dispatching."
            }
          }
        },
        {
          "type": "stream_event",
          "event": {
            "type": "content_block_stop",
            "index": 0
          }
        },
        {
          "type": "stream_event",
          "event": {
            "type": "message_stop"
          }
        },
        {
          "type": "assistant",
          "message": {
            "id": "msg_h1",
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Dispatching."
              }
            ]
          }
        }
      ]
    },
    {
      "on": {
        "type": "prompt"
      },
      "emit": [
        {
          "type": "result",
          "subtype": "success",
          "stop_reason": "end_turn",
          "duration_ms": 5,
          "total_cost_usd": 0.0001,
          "is_error": false
        },
        {
          "type": "system",
          "subtype": "init",
          "session_id": "$SID",
          "cwd": "$CWD",
          "model": "claude-sonnet-4-6",
          "permissionMode": "$MODE"
        },
        {
          "type": "system",
          "subtype": "status",
          "status": "requesting",
          "session_id": "$SID"
        },
        {
          "type": "stream_event",
          "event": {
            "type": "message_start",
            "message": {
              "id": "msg_h2",
              "role": "assistant",
              "model": "claude-sonnet-4-6",
              "usage": {
                "input_tokens": 1,
                "output_tokens": 0
              }
            }
          }
        },
        {
          "type": "stream_event",
          "event": {
            "type": "content_block_start",
            "index": 0,
            "content_block": {
              "type": "text",
              "text": ""
            }
          }
        },
        {
          "type": "stream_event",
          "event": {
            "type": "content_block_delta",
            "index": 0,
            "delta": {
              "type": "text_delta",
              "text": "Waiting on the worker."
            }
          }
        },
        {
          "type": "stream_event",
          "event": {
            "type": "content_block_stop",
            "index": 0
          }
        },
        {
          "type": "stream_event",
          "event": {
            "type": "message_stop"
          }
        },
        {
          "type": "assistant",
          "message": {
            "id": "msg_h2",
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Waiting on the worker."
              }
            ]
          }
        },
        {
          "type": "result",
          "subtype": "success",
          "stop_reason": "end_turn",
          "duration_ms": 5,
          "total_cost_usd": 0.0001,
          "is_error": false
        }
      ]
    }
  ]
}
