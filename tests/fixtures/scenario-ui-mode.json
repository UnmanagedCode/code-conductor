{
 "_comment": "UI-mode e2e (tests/ui-mode-*-e2e.test.mjs), one scenario for every process: '[Headless run]' (the root's run turn), 'HOLD-THE-TURN' and 'WORK-ITEM' (a worker's) open a turn that never ends on its own; 'ASK-ME' raises a tool AskUserQuestion that the deny ends; every other prompt ends the open turn with one message (several, one consumed per prompt).",
 "events": [
  {
   "type": "system",
   "subtype": "init",
   "session_id": "$SID",
   "cwd": "$CWD",
   "model": "claude-sonnet-4-6",
   "permissionMode": "$MODE"
  }
 ],
 "turns": [
  {
   "on": {
    "type": "prompt",
    "text": "[Headless run]"
   },
   "emit": [
    {
     "type": "stream_event",
     "event": {
      "type": "message_start",
      "message": {
       "id": "msg_u_run",
       "role": "assistant"
      }
     }
    },
    {
     "type": "stream_event",
     "event": {
      "type": "content_block_start",
      "index": 0,
      "content_block": {
       "type": "text",
       "text": ""
      }
     }
    },
    {
     "type": "stream_event",
     "event": {
      "type": "content_block_delta",
      "index": 0,
      "delta": {
       "type": "text_delta",
       "text": "Dispatching."
      }
     }
    },
    {
     "type": "stream_event",
     "event": {
      "type": "content_block_stop",
      "index": 0
     }
    },
    {
     "type": "stream_event",
     "event": {
      "type": "message_stop"
     }
    },
    {
     "type": "assistant",
     "message": {
      "id": "msg_u_run",
      "role": "assistant",
      "content": [
       {
        "type": "text",
        "text": "Dispatching."
       }
      ]
     }
    }
   ]
  },
