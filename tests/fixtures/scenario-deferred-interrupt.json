{
  "events": [
    { "type": "system", "subtype": "init", "session_id": "$SID", "cwd": "$CWD", "model": "claude-sonnet-4-6", "permissionMode": "$MODE", "tools": ["Bash"], "uuid": "di-init-1" }
  ],
  "turns": [
    {
      "on": { "type": "prompt", "text": "open text" },
      "emit": [
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_di1", "role": "assistant" } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "answering..." } } }
      ]
    },
    {
      "on": { "type": "prompt", "text": "open tool" },
      "emit": [
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_di2", "role": "assistant" } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "tool_use", "id": "tu_di_bash", "name": "Bash", "input": {} } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": "{\"command\":\"ls\"}" } } }
      ]
    },
    {
      "on": { "type": "prompt", "text": "gap" },
      "emit": [
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_di3", "role": "assistant" } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "done thinking" } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 0 } }
      ]
    },
    {
      "on": { "type": "control", "subtype": "interrupt" },
      "emit": [
        { "type": "user", "message": { "role": "user", "content": [ { "type": "text", "text": "[Request interrupted by user]" } ] }, "parent_tool_use_id": null },
        { "type": "result", "subtype": "error_during_execution", "stop_reason": "interrupted", "duration_ms": 20, "total_cost_usd": 0.0001, "is_error": true }
      ]
    }
  ]
}
