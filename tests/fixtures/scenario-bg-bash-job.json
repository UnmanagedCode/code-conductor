{
  "events": [
    { "type": "system", "subtype": "init", "session_id": "$SID", "cwd": "$CWD", "model": "claude-sonnet-4-6", "permissionMode": "$MODE", "tools": ["Bash", "TaskStop"], "uuid": "init-1" }
  ],
  "turns": [
    {
      "on": { "type": "prompt" },
      "emit": [
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_j1", "role": "assistant", "usage": { "input_tokens": 1, "output_tokens": 0 } } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "tool_use", "id": "tu_bgjob1", "name": "Bash", "input": {} } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": "{\"command\":\"sleep 8; echo done\",\"description\":\"sleep probe\",\"run_in_background\":true}" } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 0 } },
        { "type": "stream_event", "event": { "type": "message_stop" } },
        { "type": "system", "subtype": "background_tasks_changed", "tasks": [ { "task_id": "bgjob1", "task_type": "local_bash", "description": "sleep probe" } ] },
        { "type": "system", "subtype": "task_started", "task_id": "bgjob1", "tool_use_id": "tu_bgjob1", "description": "sleep probe", "is_backgrounded": true, "task_type": "local_bash" },
        {
          "type": "user",
          "message": { "role": "user", "content": [ { "type": "tool_result", "tool_use_id": "tu_bgjob1", "content": "Command running in background with ID: bgjob1. Output is being written to: /tmp/claude-UID/-workspace-project/tasks/bgjob1.output", "is_error": false } ] }
        },
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_j2", "role": "assistant", "usage": { "input_tokens": 1, "output_tokens": 0 } } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "Started the probe." } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 0 } },
        { "type": "stream_event", "event": { "type": "message_stop" } },
        { "type": "result", "subtype": "success", "stop_reason": "end_turn", "duration_ms": 20, "total_cost_usd": 0.0001, "is_error": false }
      ]
    },
    {
      "on": { "type": "control", "subtype": "cc_test_job_exit" },
      "emit": [
        { "type": "system", "subtype": "background_tasks_changed", "tasks": [] },
        { "type": "system", "subtype": "task_updated", "task_id": "bgjob1", "patch": { "status": "completed", "end_time": 1 } },
        { "type": "system", "subtype": "task_notification", "task_id": "bgjob1", "tool_use_id": "tu_bgjob1", "status": "completed", "output_file": "/tmp/claude-UID/-workspace-project/tasks/bgjob1.output", "summary": "Background command \"sleep probe\" completed (exit code 0)" },
        { "type": "system", "subtype": "init", "session_id": "$SID", "cwd": "$CWD", "model": "claude-sonnet-4-6", "permissionMode": "$MODE", "tools": ["Bash", "TaskStop"], "uuid": "init-2" },
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_j3", "role": "assistant", "usage": { "input_tokens": 1, "output_tokens": 0 } } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "The probe finished." } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 0 } },
        { "type": "stream_event", "event": { "type": "message_stop" } },
        { "type": "result", "subtype": "success", "stop_reason": "end_turn", "duration_ms": 20, "total_cost_usd": 0.0001, "is_error": false }
      ]
    }
  ]
}
