        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_epf_1", "role": "assistant" } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "tool_use", "id": "tu_epf_write", "name": "Write", "input": {} } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": "{\"file_path\":\"$PLANFILE\",\"content\":\"# Plan\\n- Make X\"}" } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 0 } },
        { "type": "user", "message": { "role": "user", "content": [ { "type": "tool_result", "tool_use_id": "tu_epf_write", "content": "File written", "is_error": false } ] } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 1, "content_block": { "type": "tool_use", "id": "tu_epf_exit", "name": "ExitPlanMode", "input": {} } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 1, "delta": { "type": "input_json_delta", "partial_json": "{}" } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 1 } },
        { "type": "user", "message": { "role": "user", "content": [ { "type": "tool_result", "tool_use_id": "tu_epf_exit", "content": "Delivered — the user can see your request in the orchestrator UI now. The tool result is flagged as an error only because the reply arrives asynchronously; the tool worked. Do not repeat the call, do not answer or decide it yourself, and do not start other work. End your turn now with no further tool calls and wait for the user's reply; it arrives as a new message.", "is_error": true } ] } },
        { "type": "stream_event", "event": { "type": "message_stop" } },
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_epf_2", "role": "assistant" } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "Standing by for approval." } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 0 } },
        { "type": "stream_event", "event": { "type": "message_stop" } },
        { "type": "result", "subtype": "success", "stop_reason": "end_turn", "duration_ms": 5, "total_cost_usd": 0.0, "is_error": false }
      ]
    }
  ]
