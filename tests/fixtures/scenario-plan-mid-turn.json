{
  "_comment": "scenario-plan.json, except the ExitPlanMode deny does NOT end the turn: a fresh assistant message opens a text block and stops there. That is the real shape whenever the CLI has anything queued behind the deny, and it is the state _fireAutoApprovePlan's approval prompt lands in. The control:interrupt turn lets the aborted turn emit a result; without it the session never leaves 'turn' and the test dies on the runner's per-file timeout. The last turn answers a POST_STOP_STEER_NOTE-carrying prompt (deferred deliveries only — a live mid-turn injection carries MID_TURN_NOTE, which lacks that clause) so the steered turn completes.",
  "events": [
    { "type": "system", "subtype": "init", "session_id": "$SID", "cwd": "$CWD", "permissionMode": "plan" }
  ],
  "turns": [
    {
      "on": { "type": "prompt", "text": "plan something" },
      "emit": [
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_pm1", "role": "assistant" } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "tool_use", "id": "tu_write", "name": "Write", "input": {} } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "input_json_delta", "partial_json": "{\"file_path\":\"$PLANFILE\",\"content\":\"# Plan\\n- Make X\\n- Then Y\"}" } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 0 } },
        { "type": "user", "message": { "role": "user", "content": [ { "type": "tool_result", "tool_use_id": "tu_write", "content": "File written", "is_error": false } ] } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 1, "content_block": { "type": "tool_use", "id": "tu_exit", "name": "ExitPlanMode", "input": {} } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 1, "delta": { "type": "input_json_delta", "partial_json": "{}" } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 1 } },
        { "type": "user", "message": { "role": "user", "content": [ { "type": "tool_result", "tool_use_id": "tu_exit", "content": "Delivered — the user can see your request in the orchestrator UI now. The tool result is flagged as an error only because the reply arrives asynchronously; the tool worked. Do not repeat the call, do not answer or decide it yourself, and do not start other work. End your turn now with no further tool calls; the user's reply comes as a later message.", "is_error": true } ] } },
        { "type": "stream_event", "event": { "type": "message_stop" } },
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_pm2", "role": "assistant" } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "still working..." } } }
      ]
    },
    {
      "on": { "type": "prompt", "text": "STOPPED at a block boundary" },
      "emit": [
        { "type": "stream_event", "event": { "type": "message_start", "message": { "id": "msg_pm_steered", "role": "assistant" } } },
        { "type": "stream_event", "event": { "type": "content_block_start", "index": 0, "content_block": { "type": "text", "text": "" } } },
        { "type": "stream_event", "event": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "on it" } } },
        { "type": "stream_event", "event": { "type": "content_block_stop", "index": 0 } },
        { "type": "stream_event", "event": { "type": "message_stop" } },
        { "type": "result", "subtype": "success", "stop_reason": "end_turn", "duration_ms": 5, "total_cost_usd": 0.0001, "is_error": false }
      ]
    },
    {
      "on": { "type": "control", "subtype": "interrupt" },
      "emit": [
        { "type": "user", "message": { "role": "user", "content": [ { "type": "text", "text": "[Request interrupted by user]" } ] }, "parent_tool_use_id": null },
        { "type": "result", "subtype": "error_during_execution", "stop_reason": "interrupted", "duration_ms": 20, "total_cost_usd": 0.0001, "is_error": true }
      ]
    }
  ]
}
