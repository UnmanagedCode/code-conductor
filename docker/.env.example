# code-conductor docker deployment — copy to .env and fill in.
# All variables are read by docker compose interpolation; the Makefile in this
# directory is the canonical invocation.

# ── REQUIRED ─────────────────────────────────────────────────────────────
# Host path of the projects root — every user project, cc's own store
# (.code-conductor/), .conduct/, and (with CC_MOUNT=inside) the cc checkout
# itself. Rules, all enforced by the container entrypoint at boot:
#   - must be OUTSIDE the cc repo (not inside a git tree — cc refuses such
#     placements late; the entrypoint refuses at boot instead);
#   - create it on the host first:  mkdir -p <path>
#   - writable by CC_UID/CC_GID:    chown <uid>:<gid> <path>
CC_PROJECTS_DIR=

# ── Common overrides ─────────────────────────────────────────────────────
#CC_PORT=8787                       # host port (container side is fixed 8787)
#CC_BIND=127.0.0.1                  # published-port host IP; widen deliberately (e.g. 0.0.0.0)
#CC_UID=1000                        # = owner of CC_PROJECTS_DIR (stat -c '%u %g' <dir>)
#CC_GID=1000
#CC_HOME_DIR=                       # container $HOME; default <CC_PROJECTS_DIR>/.cc-home
#CC_TZ=UTC

# ── Auth ─────────────────────────────────────────────────────────────────
# PRIMARY: sign in inside the container after `make up` — `make login`
# (runs `claude` there). Credentials persist across container recreation:
# $HOME is <CC_PROJECTS_DIR>/.cc-home on the host projects-root bind.
# Alternatives: bind the host's ~/.claude into the container $HOME (see
# compose.yaml's commented volume) to reuse the host OAuth sign-in; or
#CLAUDE_BIN=                        # alternative claude binary path inside the container

# ── Optional tooling (build-time flags, default OFF) ─────────────────────
# Baked into the image at build time only — never installed at boot. To change
# a flag, rebuild: make up (always builds) or make build. Sizes are upstream
# estimates, not measured here.
#CC_WITH_DOCKERIO=1     # ~350 MB  docker.io CLI; also enable the socket mount (make up-docker-provider)
#CC_WITH_CLOUDFLARED=1  # ~60 MB   cloudflared (cloudflare apt repo)
#CC_WITH_TAILSCALE=1    # ~120 MB  tailscale (install.sh)
#CC_WITH_CODEX=1        # ~100–200 MB  @openai/codex (npm global)
#CC_WITH_OLLAMA=1       # ~1–2 GB  ollama (install.sh); `ollama serve` must be started manually inside the container if wanted; pulled models persist under $HOME (.cc-home/.ollama)

# ── Optional stacks (selected by Makefile variables, NOT env vars here) ──
#   docker System provider → set CC_WITH_DOCKERIO=1 above AND `make up-docker-provider`
#   SYSTEMS / fuse-union   → make up-systems
#   GPU for ollama         → CC_WITH_OLLAMA=1 above AND `make GPU=1 up` (needs nvidia-container-toolkit on the host)

# ── cc mount position ────────────────────────────────────────────────────
# With the Makefile, the knob is CC_MOUNT (a make variable, not an env var):
#   make CC_MOUNT=inside up
# The Makefile resolves it to CC_REPO_TARGET (the container path). A
# CC_REPO_TARGET set here is NOT read by make — with raw compose (no
# Makefile), set CC_REPO_TARGET directly instead:
#   outside (default) → CC_REPO_TARGET=/workspaces/code-conductor
#   inside            → CC_REPO_TARGET=/workspaces/projects/code-conductor

# ── Raw-compose equivalent (no Makefile), from this directory ────────────
#   docker compose -f compose.yaml -f compose.systems.yaml up -d --build

# ── Older setups (docker-compose v1 or no compose plugin) ────────────────
#   make DOCKER_COMPOSE=docker-compose up
#   or: export DOCKER_COMPOSE=docker-compose